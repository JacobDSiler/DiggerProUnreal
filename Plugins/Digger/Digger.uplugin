{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.9.0-beta",
	"FriendlyName": "Digger",
	"Description": "Real-time landscape sculpting powered by a sparse voxel grid and Marching Cubes meshing. Dig caves, carve tunnels, and shape terrain directly in the Unreal Editor viewport.",
	"Category": "Level Design",
	"CreatedBy": "J.D. Siler",
	"CreatedByURL": "",
	"DocsURL": "",
	"SupportURL": "",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,

	"Plugins": [
		{
			"Name": "ProceduralMeshComponent",
			"Enabled": true
		},
		{
			"Name": "SocketIOClient",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "Niagara",
			"Enabled": true
		}
	],

	"Modules": [
		{
			"Name": "Digger",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"AdditionalDependencies": [
				"Core",
				"CoreUObject",
				"Engine",
				"ProceduralMeshComponent"
			]
		},
		{
			"Name": "DiggerEditor",
			"Type": "Editor",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"AdditionalDependencies": [
				"Core",
				"CoreUObject",
				"Engine",
				"UnrealEd",
				"DeveloperSettings",
				"ProceduralMeshComponent"
			]
		}
	]
}
